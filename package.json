{
  "name": "scroll-studio",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "build:runtime": "vite build --config vite.export.config.ts && node scripts/export-notices.ts",
    "build": "npm run typecheck && npm run build:runtime && vite build",
    "build:pages": "npm run typecheck && npm run build:runtime && vite build --base=/Scroll-Studio/",
    "preview": "vite preview --host 127.0.0.1",
    "preview:pages": "vite preview --host 127.0.0.1 --base=/Scroll-Studio/",
    "test": "vitest run",
    "test:smoke": "node scripts/smoke.ts"
  },
  "dependencies": {
    "@lucide/vue": "^1.56.0",
    "fflate": "0.8.3",
    "gsap": "^3.15.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^29.1.1",
    "playwright": "1.64.1",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "vue-tsc": "^3.3.13"
  }
}
